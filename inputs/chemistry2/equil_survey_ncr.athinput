# NCR equilibria for tst/tools/chemistry2/equil_survey.cpp:
#   chemistry2_equil_survey -i equil_survey_ncr.athinput [problem/key=value ...]
# Default grid: unshielded gas, Kim J.-G. et al. (2023) Fig. 5 (left), n_H 1e-2 to 1e3
# cm^-3, chi0 0.1 to 1e3 with xi_CR = 2e-16 chi0 s^-1, Z_g = Z_d = 1.

<chemistry2>
network          = NCR
ode_solver       = semi_implicit
NCR_Z_d          = 1.0        # replaced per grid point by the survey axes
NCR_Z_g          = 1.0
NCR_cool_hyd_cie = true

<problem>
mode       = full           # full: chemistry and T; fixed_t: chemistry at log_T
log_nH     = -2 3 161       # log10 min, max, points
log_Zg     = 0 0 1
log_Zd     = tied           # tied: Z_d = Z_g
log_chi    = -1 3 5
log_xi     = tied           # tied: xi_CR = xi_per_chi chi
xi_per_chi = 2e-16          # [s^-1]
log_T      = 3 3 1          # start T [K] of the full solve
dt_max     = 1.0e5          # longest substep [Myr]
nsub_max   = 20000          # maximum number of substeps
tol        = 1.0e-6         # relative change per substep at convergence
output     = equil_survey_ncr.txt
